# NOTE: when this file exists, `dart pub publish` uses it INSTEAD of .gitignore,
# so every build/tooling artifact we want to keep out of the package archive
# must be listed here (patterns are git-ignore syntax, matched at any depth).

# Local-only scripts
publish.sh

# NOTE: do NOT add `packages/` here. Pub reads a parent .pubignore when
# publishing a nested package too, so excluding the directory here hides the
# bridge package's own pubspec from its own `pub publish`. The bridge's source
# is small; it rides along in this archive, and its build artifacts are
# excluded by the rules below.

# Pigeon input: consumers get the generated output, not the generator, and
# the pigeon dev-dependency is not resolved for them.
pigeon.dart

# Build & tooling artifacts
build/
.dart_tool/
.fvm/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
*.symbols
*.map.json

# IDE / editor / OS
.idea/
*.iml
.vscode/
.DS_Store

# Test coverage
coverage/

# iOS / macOS ephemeral & dependencies
**/Pods/
**/.symlinks/
**/Flutter/ephemeral/
**/Flutter/Generated.xcconfig
**/Flutter/flutter_export_environment.sh
**/xcuserdata/
**/DerivedData/
.build/
**/.build/
